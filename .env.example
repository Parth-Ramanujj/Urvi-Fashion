# ---- Database (production: Render PostgreSQL) ----
# PostgreSQL 14+. All tables, foreign keys, views and migrations are created automatically on first start,
# and an existing data/db.json is imported once. Leave empty to use the JSON file in DATA_DIR (local dev / demos only).
# Example: postgresql://user:password@host:5432/urvi_fashion
DATABASE_URL=
DB_POOL_SIZE=10

# ---- Required in production ----
# Long random string used to sign login cookies (different for every store)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- White-label: setting up a NEW client store ----
# DEMO_DATA=false starts an EMPTY store (no demo products, orders or demo passwords) the first time it runs.
# The owner's admin login is created from ADMIN_EMAIL / ADMIN_PASSWORD (8+ chars, letters + numbers).
# Everything else (name, logo, app icon, colours, fonts, contact, GSTIN...) is set later in Admin → Branding.
DEMO_DATA=true
STORE_NAME=My Store
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where this store keeps its data and uploads (local fallback when CLOUDINARY_URL is not set).
DATA_DIR=./data

# ---- Cloud Image Storage (recommended on Render: 25 GB free) ----
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ---- Optional: "Continue with Google" (OAuth 2.0 web client) ----
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of this store. Required for Artha webhooks and absolute links in messages.
APP_URL=http://localhost:3000

# ---- Artha: WhatsApp + social automation (optional) ----
# Base URL and session id can also be edited in Admin → CRM → Settings. The API key is server-only.
ARTHA_API_URL=https://artha-qniz.onrender.com
ARTHA_API_KEY=
ARTHA_SESSION_ID=
# Optional shared secret for inbound webhooks; the admin can generate one on registration.
INTEGRATION_WEBHOOK_SECRET=
# Protects GET/POST /api/integrations/cron (Authorization: Bearer or ?token=). Open when empty.
CRON_SECRET=

# ---- Meta Pixel / Conversions API / Ads (optional) ----
META_PIXEL_ID=
META_CAPI_TOKEN=
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0

# ---- Database (production) ----
# MySQL 8+ (or MariaDB 10.5+). The database and all tables are created automatically on first start, and an
# existing data/db.json is imported once. Leave empty to use the JSON file in DATA_DIR (local dev / demos only).
# WAMP default: mysql://root:@127.0.0.1:3306/clothing   (production: use a dedicated user with a strong password)
DATABASE_URL=
DB_POOL_SIZE=10

# ---- Required in production ----
# Long random string used to sign login cookies (different for every store)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- White-label: setting up a NEW client store ----
# DEMO_DATA=false starts an EMPTY store (no demo products, orders or demo passwords) the first time it runs.
# The owner's admin login is created from ADMIN_EMAIL / ADMIN_PASSWORD (8+ chars, letters + numbers).
# Everything else (name, logo, app icon, colours, fonts, contact, GSTIN...) is set later in Admin → Branding.
DEMO_DATA=true
STORE_NAME=My Store
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where this store keeps its data and uploads. Give each client its own folder to run several brands from one codebase.
DATA_DIR=./data

# ---- Optional: "Continue with Google" (OAuth 2.0 web client) ----
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
